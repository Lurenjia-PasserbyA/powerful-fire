{
  "name": "powerful-fire",
  "main": "desktop/main.cjs",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "description": "Powerful Fire v1.2.3 — 2D top-down fire action RPG with authoritative LAN co-op, 38 skills, 16 enemies, 5 biomes, pooled particle FX, directional recoil and flat-tech UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "net": "node server/index.mjs",
    "server": "node server/index.mjs",
    "test:server": "node --test server/test/*.test.mjs",
    "desktop": "electron .",
    "pack:desktop": "node desktop/build.mjs",
    "android:sync": "cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "pixi.js": "^8.23.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
